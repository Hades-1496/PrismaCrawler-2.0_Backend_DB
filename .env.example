# ==========================================
# Configuración del Servidor Go
# ==========================================
PORT=8000
# URL de tu frontend (Ej: https://tu-juego.vercel.app). En local puedes dejarlo vacío o usar http://localhost:3000
ALLOWED_ORIGIN= "Deploy del frontend"

# ==========================================
# Base de Datos (Supabase / PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ==========================================
# Seguridad y Microservicios
# ==========================================
JWT_SECRET="escribe_aqui_una_clave_muy_segura_y_larga"
AI_SERVICE_URL="http://localhost:8001"
AI_INTERNAL_TOKEN="un_token_secreto_compartido_entre_go_y_python"