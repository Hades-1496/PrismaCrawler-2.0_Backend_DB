{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "PrismaCrawler Go Backend",
		"description": "Colección completa para la API principal de PrismaCrawler desarrollada en Golang.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Públicas & Auth",
			"item": [
				{
					"name": "Health Check (Ping)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ping",
							"host": ["{{base_url}}"],
							"path": ["ping"]
						}
					}
				},
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"jugador@test.com\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.token) { pm.collectionVariables.set(\"token\", jsonData.token); }"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"jugador@test.com\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Global Leaderboard",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/leaderboard",
							"host": ["{{base_url}}"],
							"path": ["api", "leaderboard"]
						}
					}
				}
			]
		},
		{
			"name": "2. Core del Juego (Requiere JWT)",
			"item": [
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{base_url}}/api/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "profile"]
						}
					}
				},
				{
					"name": "Create Character",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Guts\",\n  \"class\": \"Guerrero\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/characters",
							"host": ["{{base_url}}"],
							"path": ["api", "characters"]
						}
					}
				},
				{
					"name": "Get Characters",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{base_url}}/api/characters",
							"host": ["{{base_url}}"],
							"path": ["api", "characters"]
						}
					}
				},
				{
					"name": "Start Run",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"character_id\": 1\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/runs/start",
							"host": ["{{base_url}}"],
							"path": ["api", "runs", "start"]
						}
					}
				},
				{
					"name": "Save Run Progress",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"run_id\": 1,\n  \"current_floor\": 2,\n  \"score\": 150,\n  \"current_hp\": 80,\n  \"kills\": 3,\n  \"damage_dealt\": 90,\n  \"damage_taken\": 20\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/runs/save",
							"host": ["{{base_url}}"],
							"path": ["api", "runs", "save"]
						}
					}
				},
				{
					"name": "Get Wallet",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{base_url}}/api/wallet",
							"host": ["{{base_url}}"],
							"path": ["api", "wallet"]
						}
					}
				},
				{
					"name": "Update Wallet",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"coins\": 150,\n  \"gems\": 10\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/wallet",
							"host": ["{{base_url}}"],
							"path": ["api", "wallet"]
						}
					}
				}
			]
		},
		{
			"name": "3. Admin API (Requiere JWT + Admin)",
			"item": [
				{
					"name": "Promote User to Admin",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_id\": 2,\n  \"role\": \"ADMIN\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/admin/role",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "role"]
						}
					}
				},
				{
					"name": "Add Knowledge Chunk",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"keywords\": [\"goblin\", \"enemigo\"],\n  \"content\": \"Los goblins son criaturas débiles con 50 HP.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/admin/knowledge",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "knowledge"]
						}
					}
				}
			]
		},
		{
			"name": "4. Internal AI API (Requiere X-Internal-Token)",
			"item": [
				{
					"name": "Get Top 10",
					"request": {
						"method": "GET",
						"header": [{"key": "X-Internal-Token", "value": "{{internal_token}}"}],
						"url": {
							"raw": "{{base_url}}/api/internal/rankings/top10",
							"host": ["{{base_url}}"],
							"path": ["api", "internal", "rankings", "top10"]
						}
					}
				},
				{
					"name": "RAG Vector Search",
					"request": {
						"method": "POST",
						"header": [{"key": "X-Internal-Token", "value": "{{internal_token}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"embedding\": [0.1, -0.2, 0.5, 0.0]\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/internal/rag/search",
							"host": ["{{base_url}}"],
							"path": ["api", "internal", "rag", "search"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "internal_token",
			"value": "TU_TOKEN_SECRETO_DEL_ENV"
		}
	]
}
